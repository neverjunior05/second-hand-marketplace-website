# --- Database (PostgreSQL via Drizzle) -------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth -------------------------------------------------------------------
# 32+ random characters. Sign the JWT session cookie.
JWT_SECRET=replace-with-a-long-random-string

# --- Optional: ISBN metadata lookup -----------------------------------------
# Works with no key. Add a free Google Books key for higher quotas.
GOOGLE_BOOKS_API_KEY=

# --- Optional: real payment gateway (sandbox/live) --------------------------
# Without a key the checkout uses the built-in Bindery sandbox provider.
STRIPE_SECRET_KEY=

# --- Uploads ----------------------------------------------------------------
# Directory for uploaded cover/condition photos (served via /api/uploads/:file).
UPLOAD_DIR=
